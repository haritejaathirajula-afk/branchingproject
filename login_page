
<!DOCTYPE html>
<html>
<head>
    <title>Login Page</title>
    <style>
        body {
            font-family: Arial;
            background-color: lightblue;
            text-align: center;
            padding-top: 100px;
        }

        .login-box {
            background-color: white;
            width: 300px;
            margin: auto;
            padding: 25px;
            border-radius: 10px;
        }

        input {
            width: 90%;
            padding: 10px;
            margin: 10px;
        }

        button {
            background-color: blue;
            color: white;
            padding: 10px 30px;
            border: none;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <div class="login-box">
        <h2>Login</h2>

        <form action="welcome.html">
            <input type="text" placeholder="Enter Username" required>
            <br>

            <input type="password" placeholder="Enter Password" required>
            <br>

            <button type="submit">Login</button>
        </form>
    </div>

</body>
</html>
